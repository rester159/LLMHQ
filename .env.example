LLMHQ_HOST=127.0.0.1
LLMHQ_PORT=8080

# token: require Authorization: Bearer <key>
# none: no wrapper key required. Use only on localhost or a private Docker network.
LLMHQ_AUTH_MODE=token
LLMHQ_API_KEYS=dev-local-key
LLMHQ_ASSET_DIR=./data/assets
LLMHQ_CONVERSATION_DIR=./data/conversations
LLMHQ_WORKSPACE_DIR=./data/workspaces
LLMHQ_SETTINGS_FILE=./data/settings.json

# Regular chat/coding workers. Keep profile dirs persistent.
LLMHQ_DEFAULT_CHAT_MODEL=claude-sonnet
LLMHQ_CHAT_TIMEOUT_MS=180000
LLMHQ_MAX_CONVERSATION_MESSAGES=60
LLMHQ_WORKER_FAILURE_COOLDOWN_MS=30000

LLMHQ_CLAUDE_ENABLED=1
LLMHQ_CLAUDE_COMMAND=claude
LLMHQ_CLAUDE_WORKERS=claude-1=./data/profiles/claude-1
# Add a second Claude subscription later by changing this to:
# LLMHQ_CLAUDE_WORKERS=claude-1=./data/profiles/claude-1,claude-2=./data/profiles/claude-2
# Optional for Google Workspace/SSO-style login:
# LLMHQ_CLAUDE_LOGIN_ARGS=--sso
LLMHQ_CLAUDE_HAIKU_MODEL=haiku
LLMHQ_CLAUDE_SONNET_MODEL=sonnet
LLMHQ_CLAUDE_OPUS_MODEL=opus

LLMHQ_CODEX_ENABLED=1
LLMHQ_CODEX_COMMAND=codex
# On Windows, if the Microsoft Store shim returns "Access is denied", use the real binary path:
# LLMHQ_CODEX_COMMAND=C:\Users\edang\AppData\Local\OpenAI\Codex\bin\codex.exe
LLMHQ_CODEX_WORKERS=codex-1=./data/profiles/codex-1
# Optional for browserless Google OAuth setup where supported:
# LLMHQ_CODEX_LOGIN_ARGS=--device-auth
LLMHQ_CODEX_MODEL=gpt-5.5
LLMHQ_CODEX_WORKDIR=./data/codex-workdir

# Experimental ChatGPT web image worker.
# Requires a persistent logged-in browser profile.
LLMHQ_EXPERIMENTAL_CHATGPT_BROWSER=0
LLMHQ_CHATGPT_PROFILE_DIR=./data/browser-profiles/chatgpt-main
LLMHQ_CHATGPT_HEADLESS=0
LLMHQ_CHATGPT_TIMEOUT_MS=180000
LLMHQ_CHATGPT_URL=https://chatgpt.com/
